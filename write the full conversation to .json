  "content": "import type {\n    DependencyType,\n    ProjectAnalysis,\n    Task,\n    TaskPriority,\n    TaskStatus,\n    ZoomLevel,\n} from '@/types/gantt';\n\nexport const ROW_HEIGHT = 48;\nexport const BAR_HEIGHT = 26;\nexport const HEADER_HEIGHT = 56;\nexport const NAME_COLUMN_WIDTH = 268;\n\n/**\n * Pixels rendered per calendar day for every zoom level.\n */\nexport const ZOOM_CONFIG: Record<\n    ZoomLevel,\n    { dayWidth: number; label: string }\n> = {\n    day: { dayWidth: 40, label: 'Harian' },\n    week: { dayWidth: 16, label: 'Mingguan' },\n    month: { dayWidth: 8, label: 'Bulanan' },\n};\n\nexport const MONTH_LABELS = [\n    'Jan',\n    'Feb',\n    'Mar',\n    'Apr',\n    'Mei',\n    'Jun',\n    'Jul',\n    'Agu',\n    'Sep',\n    'Okt',\n    'Nov',\n    'Des',\n];\n\nexport const WEEKDAY_LABELS = ['Min', 'Sen', 'Sel', 'Rab', 'Kam', 'Jum', 'Sab'];\n\nexport const PRIORITY_STYLES: Record<\n    TaskPriority,\n    { bar: string; badge: string; label: string }\n> = {\n    High: {\n        bar: 'bg-rose-500 hover:bg-rose-600 text-white',\n        badge: 'bg-rose-100 text-rose-700 ring-rose-200',\n        label: 'Tinggi',\n    },\n    Medium: {\n        bar: 'bg-amber-500 hover:bg-amber-600 text-white',\n        badge: 'bg-amber-100 text-amber-700 ring-amber-200',\n        label: 'Sedang',\n    },\n    Low: {\n        bar: 'bg-sky-500 hover:bg-sky-600 text-white',\n        badge: 'bg-sky-100 text-sky-700 ring-sky-200',\n        label: 'Rendah',\n    },\n};\n\nexport const STATUS_STYLES: Record<\n    TaskStatus,\n    { badge: string; dot: string; label: string }\n> = {\n    'To Do': {\n        badge: 'bg-slate-100 text-slate-600 ring-slate-200',\n        dot: 'bg-slate-400',\n        label: 'To Do',\n    },\n    'In Progress': {\n        badge: 'bg-blue-100 text-blue-700 ring-blue-200',\n        dot: 'bg-blue-500',\n        label: 'In Progress',\n    },\n    Done: {\n        badge: 'bg-emerald-100 text-emerald-700 ring-emerald-200',\n        dot: 'bg-emerald-500',\n        label: 'Done',\n    },\n};\n\n/**\n * Parse an ISO (YYYY-MM-DD) string into a local Date at midnight.\n */\nexport function parseDate(value: string): Date {\n    const [year, month, day] = value.split('-').map(Number);\n\n    return new Date(year, (month ?? 1) - 1, day ?? 1);\n}\n\n/**\n * Format a Date as an ISO (YYYY-MM-DD) string without timezone drift.\n */\nexport function toIsoDate(date: Date): string {\n    const month = `${date.getMonth() + 1}`.padStart(2, '0');\n    const day = `${date.getDate()}`.padStart(2, '0');\n\n    return `${date.getFullYear()}-${month}-${day}`;\n}\n\nexport function addDays(date: Date, days: number): Date {\n    const next = new Date(date);\n    next.setDate(next.getDate() + days);\n\n    return next;\n}\n\n/**\n * Whole calendar days between two dates (b - a).\n */\nexport function diffInDays(a: Date, b: Date): number {\n    const start = new Date(a.getFullYear(), a.getMonth(), a.getDate());\n    const end = new Date(b.getFullYear(), b.getMonth(), b.getDate());\n\n    return Math.round((end.getTime() - start.getTime()) / 86_400_000);\n}\n\n/**\n * The Monday that starts the week containing the given date.\n */\nexport function startOfWeek(date: Date): Date {\n    const result = new Date(date);\n    const offset = (result.getDay() + 6) % 7;\n    result.setDate(result.getDate() - offset);\n\n    return result;\n}\n\nexport function formatShortDate(date: Date): string {\n    return `${`${date.getDate()}`.padStart(2, '0')} ${MONTH_LABELS[date.getMonth()]}`;\n}\n\nexport function formatLongDate(date: Date): string {\n    return `${formatShortDate(date)} ${date.getFullYear()}`;\n}\n\n/**\n * Build a flat, ordered list of tasks so parents are immediately followed by\n * their sub-tasks.\n */\nexport function orderTasksForDisplay(\n    tasks: Task[],\n): { task: Task; depth: number }[] {\n    const byParent = new Map<number | null, Task[]>();\n\n    for (const task of tasks) {\n        const key = task.parent_id;\n        const bucket = byParent.get(key) ?? [];\n        bucket.push(task);\n        byParent.set(key, bucket);\n    }\n\n    for (const bucket of byParent.values()) {\n        bucket.sort(\n            (a, b) =>\n                parseDate(a.start_date).getTime() -\n                    parseDate(b.start_date).getTime() || a.id - b.id,\n        );\n    }\n\n    const rows: { task: Task; depth: number }[] = [];\n    const visited = new Set<number>();\n\n    const walk = (parentId: number | null, depth: number): void => {\n        for (const task of byParent.get(parentId) ?? []) {\n            if (visited.has(task.id)) {\n                continue;\n            }\n\n            visited.add(task.id);\n            rows.push({ task, depth });\n            walk(task.id, depth + 1);\n        }\n    };\n\n    walk(null, 0);\n\n    // Surface any orphans (their parent was filtered out) at the top level.\n    for (const task of tasks) {\n        if (!visited.has(task.id)) {\n            visited.add(task.id);\n            rows.push({ task, depth: 0 });\n        }\n    }\n\n    return rows;\n}\n\n/**\n * Assign every task to a column of the network diagram using the longest path\n * through both dependency and parent links.\n */\nexport function computeNetworkRanks(tasks: Task[]): Record<number, number> {\n    const byId = new Map(tasks.map((task) => [task.id, task]));\n    const ranks: Record<number, number> = {};\n    const visiting = new Set<number>();\n\n    const resolve = (task: Task): number => {\n        const cached = ranks[task.id];\n\n        if (cached !== undefined) {\n            return cached;\n        }\n\n        if (visiting.has(task.id)) {\n            return 0;\n        }\n\n        visiting.add(task.id);\n\n        let rank = 0;\n\n        if (task.predecessor_id !== null && task.predecessor_id !== task.id) {\n            const predecessor = byId.get(task.predecessor_id);\n\n            if (predecessor) {\n                rank = Math.max(rank, resolve(predecessor) + 1);\n            }\n        }\n\n        if (task.parent_id !== null && task.parent_id !== task.id) {\n            const parent = byId.get(task.parent_id);\n\n            if (parent) {\n                rank = Math.max(rank, resolve(parent) + 1);\n            }\n        }\n\n        visiting.delete(task.id);\n        ranks[task.id] = rank;\n\n        return rank;\n    };\n\n    for (const task of tasks) {\n        resolve(task);\n    }\n\n    return ranks;\n}\n\nexport interface TimelineColumn {\n    key: string;\n    label: string;\n    subLabel: string;\n    width: number;\n    days: number;\n}\n\nexport interface Timeline {\n    rangeStart: Date;\n    rangeEnd: Date;\n    dayWidth: number;\n    width: number;\n    columns: TimelineColumn[];\n}\n\n/**\n * Compute the visible date range and header columns for a zoom level.\n */\nexport function buildTimeline(\n    tasks: Task[],\n    zoom: ZoomLevel,\n    today: Date,\n): Timeline {\n    const dayWidth = ZOOM_CONFIG[zoom].dayWidth;\n    const starts = tasks.map((task) => parseDate(task.start_date));\n    const ends = tasks.map((task) => parseDate(task.end_date));\n\n    let rangeStart = new Date(\n        Math.min(...starts.map((date) => date.getTime())),\n    );\n    let rangeEnd = new Date(Math.max(...ends.map((date) => date.getTime())));\n\n    if (zoom === 'week') {\n        rangeStart = startOfWeek(rangeStart);\n        rangeEnd = addDays(startOfWeek(rangeEnd), 6);\n    } else if (zoom === 'month') {\n        rangeStart = new Date(rangeStart.getFullYear(), rangeStart.getMonth(), 1);\n        rangeEnd = new Date(\n            rangeEnd.getFullYear(),\n            rangeEnd.getMonth() + 1,\n            0,\n        );\n    }\n\n    // Always keep \"today\" in view when it falls near the project window.\n    if (today >= rangeStart && today <= rangeEnd) {\n        rangeEnd = addDays(rangeEnd, 2);\n    }\n\n    const columns: TimelineColumn[] = [];\n    let cursor = new Date(rangeStart);\n\n    while (cursor <= rangeEnd) {\n        if (zoom === 'day') {\n            columns.push({\n                key: toIsoDate(cursor),\n                label: `${cursor.getDate()}`,\n                subLabel: WEEKDAY_LABELS[cursor.getDay()],\n                width: dayWidth,\n                days: 1,\n            });\n            cursor = addDays(cursor, 1);\n        } else if (zoom === 'week') {\n            const weekStart = startOfWeek(cursor);\n            let days = 0;\n            let weekCursor = new Date(weekStart);\n\n            while (\n                weekCursor <= rangeEnd &&\n                startOfWeek(weekCursor).getTime() === weekStart.getTime()\n            ) {\n                days += 1;\n                weekCursor = addDays(weekCursor, 1);\n            }\n\n            columns.push({\n                key: `w-${toIsoDate(weekStart)}`,\n                label: `Mgg ${formatShortDate(weekStart)}`,\n                subLabel: `${days} hari`,\n                width: days * dayWidth,\n                days,\n            });\n            cursor = weekCursor;\n        } else {\n            const monthStart = new Date(\n                cursor.getFullYear(),\n                cursor.getMonth(),\n                1,\n            );\n            let days = 0;\n            let monthCursor = new Date(cursor);\n\n            while (\n                monthCursor <= rangeEnd &&\n                monthCursor.getMonth() === monthStart.getMonth() &&\n                monthCursor.getFullYear() === monthStart.getFullYear()\n            ) {\n                days += 1;\n                monthCursor = addDays(monthCursor, 1);\n            }\n\n            columns.push({\n                key: `m-${monthStart.getFullYear()}-${monthStart.getMonth()}`,\n                label: `${MONTH_LABELS[monthStart.getMonth()]} ${monthStart.getFullYear()}`,\n                subLabel: `${days} hari`,\n                width: days * dayWidth,\n                days,\n            });\n            cursor = monthCursor;\n        }\n    }\n\n    const totalDays = diffInDays(rangeStart, rangeEnd) + 1;\n\n    return {\n        rangeStart,\n        rangeEnd,\n        dayWidth,\n        width: totalDays * dayWidth,\n        columns,\n    };\n}\n\nexport interface GanttBar {\n    task: Task;\n    depth: number;\n    rowIndex: number;\n    left: number;\n    width: number;\n    isCritical: boolean;\n    slack: number;\n}\n\nexport interface GanttLink {\n    id: string;\n    path: string;\n    dependencyType: DependencyType;\n    lagDays: number;\n    isCritical: boolean;\n}\n\nexport interface GanttLayout {\n    rows: GanttBar[];\n    links: GanttLink[];\n    timeline: Timeline;\n    bodyHeight: number;\n}\n\n/**\n * Lay every task bar out in pixel space and compute dependency connectors.\n */\nexport function buildGanttLayout(\n    tasks: Task[],\n    analysis: ProjectAnalysis,\n    zoom: ZoomLevel,\n    today: Date,\n): GanttLayout {\n    const ordered = orderTasksForDisplay(tasks);\n    const timeline = buildTimeline(tasks, zoom, today);\n    const { rangeStart, dayWidth, width } = timeline;\n\n    const x = (date: string): number =>\n        diffInDays(rangeStart, parseDate(date)) * dayWidth;\n\n    const rows: GanttBar[] = ordered.map(({ task, depth }, index) => {\n        const node = analysis.nodes[`${task.id}`];\n\n        return {\n            task,\n            depth,\n            rowIndex: index,\n            left: x(task.start_date),\n            width: Math.max(task.duration_days * dayWidth, 8),\n            isCritical: node?.is_critical ?? false,\n            slack: node?.slack ?? 0,\n        };\n    });\n\n    const rowByTaskId = new Map(rows.map((row) => [row.task.id, row]));\n    const links: GanttLink[] = [];\n    const gap = 12;\n\n    for (const row of rows) {\n        const { task } = row;\n\n        if (task.predecessor_id === null) {\n            continue;\n        }\n\n        const predecessorRow = rowByTaskId.get(task.predecessor_id);\n\n        if (!predecessorRow) {\n            continue;\n        }\n\n        const dependencyType = task.dependency_type ?? 'Finish-to-Start';\n        const startY = predecessorRow.rowIndex * ROW_HEIGHT + ROW_HEIGHT / 2;\n        const endY = row.rowIndex * ROW_HEIGHT + ROW_HEIGHT / 2;\n        const targetX = row.left;\n\n        let path: string;\n\n        if (dependencyType === 'Start-to-Start') {\n            const sourceX = predecessorRow.left;\n            const elbowX = Math.min(sourceX, targetX) - gap;\n            path = `M ${sourceX} ${startY} H ${elbowX} V ${endY} H ${targetX}`;\n        } else {\n            const sourceX = predecessorRow.left + predecessorRow.width;\n            const elbowX = Math.max(sourceX + gap, targetX - gap);\n            path = `M ${sourceX} ${startY} H ${elbowX} V ${endY} H ${targetX}`;\n        }\n\n        links.push({\n            id: `${predecessorRow.task.id}-${task.id}`,\n            path,\n            dependencyType,\n            lagDays: task.lag_days,\n            isCritical: row.isCritical && predecessorRow.isCritical,\n        });\n    }\n\n    return {\n        rows,\n        links,\n        timeline: { ...timeline, width },\n        bodyHeight: rows.length * ROW_HEIGHT,\n    };\n}\n\n/**\n * The x position of \"today\" inside the timeline, or null when out of range.\n */\nexport function todayMarkerX(\n    timeline: Timeline,\n    today: Date,\n): number | null {\n    const offset = diffInDays(timeline.rangeStart, today);\n\n    if (offset < 0 || offset > diffInDays(timeline.rangeStart, timeline.rangeEnd)) {\n        return null;\n    }\n\n    return offset * timeline.dayWidth;\n}\n"
}
