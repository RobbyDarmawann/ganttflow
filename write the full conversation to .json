  "instructions": "Implement the CPM/PERT analyzer computing early/late start, finish, slack and the critical path.",
  "content": "<?php\n\nnamespace App\\Support;\n\nuse App\\Enums\\DependencyType;\nuse App\\Models\\Task;\nuse Illuminate\\Support\\Carbon;\nuse Illuminate\\Support\\Collection;\n\n/**\n * Analyses a set of tasks using the Critical Path Method (CPM) so the UI can\n * highlight the critical path and draw a simple PERT / network diagram.\n *\n * Each task is treated as an Activity-on-Node with:\n *  - ES (Early Start)  : earliest day the task can begin, as an offset from project start\n *  - EF (Early Finish) : ES + duration\n *  - LS (Late Start)   : latest day the task can begin without delaying the project\n *  - LF (Late Finish)  : LS + duration\n *  - Slack / float      : LS - ES. A task with zero slack sits on the critical path.\n *\n * Durations are counted in calendar days (the app labels them \"working days\").\n */\nclass CriticalPathAnalyzer\n{\n    /**\n     * Analyse the given tasks and return the schedule network.\n     *\n     * @param  Collection<int, Task>  $tasks\n     * @return array{\n     *     has_tasks: bool,\n     *     project_start: string|null,\n     *     project_end: string|null,\n     *     project_duration_days: int,\n     *     critical_path_names: array<int, string>,\n     *     nodes: array<int, array{\n     *         id: int,\n     *         name: string,\n     *         level: int,\n     *         duration_days: int,\n     *         early_start: int,\n     *         early_finish: int,\n     *         late_start: int,\n     *         late_finish: int,\n     *         slack: int,\n     *         is_critical: bool\n     *     }>\n     * }\n     */\n    public function analyze(Collection $tasks): array\n    {\n        if ($tasks->isEmpty()) {\n            return [\n                'has_tasks' => false,\n                'project_start' => null,\n                'project_end' => null,\n                'project_duration_days' => 0,\n                'critical_path_names' => [],\n                'nodes' => [],\n            ];\n        }\n\n        /** @var array<int, Task> $byId */\n        $byId = $tasks->keyBy('id')->all();\n\n        $projectStart = $tasks\n            ->map(fn (Task $task): Carbon => $task->start_date->copy()->startOfDay())\n            ->sort()\n            ->first();\n\n        $duration = [];\n        $earlyStart = [];\n        $earlyFinish = [];\n        $lateStart = [];\n        $lateFinish = [];\n        $slack = [];\n        $level = [];\n\n        foreach ($byId as $id => $task) {\n            $duration[$id] = max(1, (int) $task->duration_days);\n            $earlyStart[$id] = (int) $projectStart->diffInDays($task->start_date->copy()->startOfDay());\n            $level[$id] = 0;\n        }\n\n        $order = $this->topologicalOrder($byId);\n\n        // Forward pass: compute the earliest start/finish of every task.\n        foreach ($order as $id) {\n            $task = $byId[$id];\n            $predecessorId = $this->dependencyId($task, $byId);\n\n            if ($predecessorId !== null) {\n                $constraint = $this->forwardConstraint(\n                    $task,\n                    $predecessorId,\n                    $earlyStart,\n                    $earlyFinish,\n                );\n\n                $earlyStart[$id] = max($earlyStart[$id], $constraint);\n                $level[$id] = $level[$predecessorId] + 1;\n            }\n\n            $earlyFinish[$id] = $earlyStart[$id] + $duration[$id];\n        }\n\n        $projectEnd = max($earlyFinish);\n        $successors = $this->successorMap($byId);\n\n        // Backward pass: compute the latest start/finish of every task.\n        foreach (array_reverse($order) as $id) {\n            $dependent = $successors[$id] ?? [];\n\n            if ($dependent === []) {\n                $lateFinish[$id] = $projectEnd;\n            } else {\n                $lateFinish[$id] = min(array_map(\n                    fn (int $successorId): int => $this->backwardConstraint(\n                        $byId[$successorId],\n                        $id,\n                        $lateStart,\n                        $lateFinish,\n                        $duration,\n                    ),\n                    $dependent,\n                ));\n            }\n\n            $lateStart[$id] = $lateFinish[$id] - $duration[$id];\n            $slack[$id] = $lateStart[$id] - $earlyStart[$id];\n        }\n\n        $nodes = [];\n        foreach ($byId as $id => $task) {\n            $nodes[$id] = [\n                'id' => $id,\n                'name' => $task->name,\n                'level' => $level[$id],\n                'duration_days' => $duration[$id],\n                'early_start' => $earlyStart[$id],\n                'early_finish' => $earlyFinish[$id],\n                'late_start' => $lateStart[$id],\n                'late_finish' => $lateFinish[$id],\n                'slack' => $slack[$id],\n                'is_critical' => $slack[$id] <= 0,\n            ];\n        }\n\n        $criticalNames = $byId\n            ->filter(fn (Task $task): bool => $slack[$task->id] <= 0)\n            ->sortBy(fn (Task $task): int => $earlyStart[$task->id])\n            ->map(fn (Task $task): string => $task->name)\n            ->values()\n            ->all();\n\n        return [\n            'has_tasks' => true,\n            'project_start' => $projectStart->toDateString(),\n            'project_end' => $projectStart->copy()->addDays($projectEnd - 1)->toDateString(),\n            'project_duration_days' => $projectEnd,\n            'critical_path_names' => $criticalNames,\n            'nodes' => $nodes,\n        ];\n    }\n\n    /**\n     * Order the tasks so that every task appears after its predecessor.\n     *\n     * @param  array<int, Task>  $tasks\n     * @return array<int, int>\n     */\n    private function topologicalOrder(array $tasks): array\n    {\n        $indegree = [];\n        $successors = [];\n\n        foreach ($tasks as $id => $task) {\n            $indegree[$id] ??= 0;\n            $predecessorId = $this->dependencyId($task, $tasks);\n\n            if ($predecessorId === null) {\n                continue;\n            }\n\n            $indegree[$id] = ($indegree[$id] ?? 0) + 1;\n            $successors[$predecessorId][] = $id;\n        }\n\n        $queue = array_keys(array_filter($indegree, fn (int $degree): bool => $degree === 0));\n\n        // Deterministic ordering keeps the network diagram stable between renders.\n        usort($queue, fn (int $a, int $b): int => $a <=> $b);\n\n        $order = [];\n\n        while ($queue !== []) {\n            $id = array_shift($queue);\n            $order[] = $id;\n\n            foreach ($successors[$id] ?? [] as $successorId) {\n                $indegree[$successorId]--;\n\n                if ($indegree[$successorId] === 0) {\n                    $queue[] = $successorId;\n                }\n            }\n        }\n\n        // Guard against cycles: append anything we could not order so the\n        // analysis still renders instead of failing.\n        if (count($order) < count($tasks)) {\n            foreach (array_keys($tasks) as $id) {\n                if (! in_array($id, $order, true)) {\n                    $order[] = $id;\n                }\n            }\n        }\n\n        return $order;\n    }\n\n    /**\n     * Resolve a task's predecessor id, ignoring self references.\n     *\n     * @param  array<int, Task>  $tasks\n     */\n    private function dependencyId(Task $task, array $tasks): ?int\n    {\n        $predecessorId = $task->predecessor_id;\n\n        if ($predecessorId === null || $predecessorId === $task->id) {\n            return null;\n        }\n\n        return isset($tasks[$predecessorId]) ? $predecessorId : null;\n    }\n\n    /**\n     * Earliest day the task may start given its predecessor.\n     *\n     * @param  array<int, int>  $earlyStart\n     * @param  array<int, int>  $earlyFinish\n     */\n    private function forwardConstraint(\n        Task $task,\n        int $predecessorId,\n        array $earlyStart,\n        array $earlyFinish,\n    ): int {\n        $lag = max(0, (int) $task->lag_days);\n\n        return match ($task->dependency_type) {\n            DependencyType::StartToStart => $earlyStart[$predecessorId] + $lag,\n            default => $earlyFinish[$predecessorId] + $lag,\n        };\n    }\n\n    /**\n     * Latest day the predecessor may finish without delaying the successor.\n     *\n     * @param  array<int, int>  $lateStart\n     * @param  array<int, int>  $lateFinish\n     * @param  array<int, int>  $duration\n     */\n    private function backwardConstraint(\n        Task $successor,\n        int $predecessorId,\n        array $lateStart,\n        array $lateFinish,\n        array $duration,\n    ): int {\n        $lag = max(0, (int) $successor->lag_days);\n\n        return match ($successor->dependency_type) {\n            DependencyType::StartToStart => $lateStart[$successor->id] - $lag + $duration[$predecessorId],\n            default => $lateStart[$successor->id] - $lag,\n        };\n    }\n\n    /**\n     * Map every task id to the ids of the tasks that depend on it.\n     *\n     * @param  array<int, Task>  $tasks\n     * @return array<int, array<int, int>>\n     */\n    private function successorMap(array $tasks): array\n    {\n        $successors = [];\n\n        foreach ($tasks as $task) {\n            $predecessorId = $this->dependencyId($task, $tasks);\n\n            if ($predecessorId !== null) {\n                $successors[$predecessorId][] = $task->id;\n            }\n        }\n\n        return $successors;\n    }\n}\n"
}
