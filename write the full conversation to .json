  "instructions": "Create the PERT/network diagram view with ES/EF/LS/LF and slack.",
  "content": "import { Network, Route, TriangleAlert } from 'lucide-react';\nimport { useMemo } from 'react';\nimport { computeNetworkRanks, formatLongDate, parseDate } from '@/lib/gantt';\nimport { cn } from '@/lib/utils';\nimport type { ProjectAnalysis, Task } from '@/types/gantt';\n\ninterface NetworkDiagramProps {\n    tasks: Task[];\n    analysis: ProjectAnalysis;\n    onSelect: (task: Task) => void;\n}\n\nconst NODE_WIDTH = 208;\nconst NODE_HEIGHT = 132;\nconst GAP_X = 84;\nconst GAP_Y = 26;\nconst PADDING = 32;\n\ninterface PositionedNode {\n    task: Task;\n    x: number;\n    y: number;\n    isCritical: boolean;\n}\n\nexport default function NetworkDiagram({\n    tasks,\n    analysis,\n    onSelect,\n}: NetworkDiagramProps) {\n    const graph = useMemo(() => {\n        const ranks = computeNetworkRanks(tasks);\n        const columns = new Map<number, Task[]>();\n\n        for (const task of tasks) {\n            const rank = ranks[task.id] ?? 0;\n            const bucket = columns.get(rank) ?? [];\n            bucket.push(task);\n            columns.set(rank, bucket);\n        }\n\n        const nodeByTaskId = new Map<number, PositionedNode>();\n        const ordered = [...columns.entries()].sort(([a], [b]) => a - b);\n\n        const columnHeights = ordered.map(([, columnTasks]) => {\n            const sorted = [...columnTasks].sort(\n                (a, b) =>\n                    parseDate(a.start_date).getTime() -\n                        parseDate(b.start_date).getTime() || a.id - b.id,\n            );\n\n            return (\n                sorted.length * NODE_HEIGHT + (sorted.length - 1) * GAP_Y\n            );\n        });\n\n        const maxHeight = Math.max(...columnHeights, 0);\n\n        ordered.forEach(([rank, columnTasks], columnIndex) => {\n            const sorted = [...columnTasks].sort(\n                (a, b) =>\n                    parseDate(a.start_date).getTime() -\n                        parseDate(b.start_date).getTime() || a.id - b.id,\n            );\n\n            const offsetY = PADDING + (maxHeight - columnHeights[columnIndex]) / 2;\n\n            sorted.forEach((task, rowIndex) => {\n                nodeByTaskId.set(task.id, {\n                    task,\n                    x: PADDING + rank * (NODE_WIDTH + GAP_X),\n                    y: offsetY + rowIndex * (NODE_HEIGHT + GAP_Y),\n                    isCritical:\n                        analysis.nodes[`${task.id}`]?.is_critical ?? false,\n                });\n            });\n        });\n\n        const nodes = [...nodeByTaskId.values()];\n        const edges: { id: string; path: string; isCritical: boolean }[] = [];\n\n        for (const task of tasks) {\n            if (task.predecessor_id === null) {\n                continue;\n            }\n\n            const source = nodeByTaskId.get(task.predecessor_id);\n            const target = nodeByTaskId.get(task.id);\n\n            if (!source || !target) {\n                continue;\n            }\n\n            const x1 = source.x + NODE_WIDTH;\n            const y1 = source.y + NODE_HEIGHT / 2;\n            const x2 = target.x;\n            const y2 = target.y + NODE_HEIGHT / 2;\n\n            edges.push({\n                id: `${source.task.id}-${task.id}`,\n                path: `M ${x1} ${y1} C ${x1 + 48} ${y1}, ${x2 - 48} ${y2}, ${x2} ${y2}`,\n                isCritical: source.isCritical && target.isCritical,\n            });\n        }\n\n        const width = Math.max(...nodes.map((node) => node.x + NODE_WIDTH), 0) + PADDING;\n        const height = Math.max(...nodes.map((node) => node.y + NODE_HEIGHT), 0) + PADDING;\n\n        return { nodes, edges, width, height };\n    }, [tasks, analysis]);\n\n    if (tasks.length === 0) {\n        return (\n            <div className=\"flex flex-col items-center justify-center gap-3 rounded-xl border border-dashed border-slate-300 bg-white px-6 py-16 text-center\">\n                <Network className=\"h-8 w-8 text-slate-300\" />\n                <p className=\"text-sm font-medium text-slate-600\">\n                    Diagram jaringan belum tersedia\n                </p>\n                <p className=\"max-w-sm text-xs text-slate-400\">\n                    Tambahkan tugas dan dependensi untuk membentuk diagram\n                    jaringan proyek.\n                </p>\n            </div>\n        );\n    }\n\n    return (\n        <div className=\"space-y-4\">\n            <div className=\"flex flex-wrap items-center gap-x-5 gap-y-2 rounded-xl border border-slate-200 bg-white px-4 py-3 text-xs text-slate-500 shadow-sm\">\n                <span className=\"flex items-center gap-1.5 font-medium text-slate-600\">\n                    <Route className=\"h-3.5 w-3.5 text-indigo-500\" />\n                    Keterangan node:\n                </span>\n                <span>\n                    <strong className=\"font-semibold text-slate-600\">ES</strong>{' '}\n                    Earliest Start\n                </span>\n                <span>\n                    <strong className=\"font-semibold text-slate-600\">EF</strong>{' '}\n                    Earliest Finish\n                </span>\n                <span>\n                    <strong className=\"font-semibold text-slate-600\">LS</strong>{' '}\n                    Latest Start\n                </span>\n                <span>\n                    <strong className=\"font-semibold text-slate-600\">LF</strong>{' '}\n                    Latest Finish\n                </span>\n                <span className=\"flex items-center gap-1.5\">\n                    <span className=\"h-2.5 w-2.5 rounded-sm bg-rose-500\" />\n                    Kritis (slack 0)\n                </span>\n            </div>\n\n            <div className=\"overflow-x-auto rounded-xl border border-slate-200 bg-[radial-gradient(circle,#e2e8f0_1px,transparent_1px)] [background-size:18px_18px] bg-white p-2 shadow-sm\">\n                <div\n                    className=\"relative\"\n                    style={{ width: graph.width, height: graph.height }}\n                >\n                    <svg\n                        className=\"pointer-events-none absolute top-0 left-0\"\n                        width={graph.width}\n                        height={graph.height}\n                        aria-hidden=\"true\"\n                    >\n                        <defs>\n                            <marker\n                                id=\"network-arrow\"\n                                viewBox=\"0 0 10 10\"\n                                refX=\"9\"\n                                refY=\"5\"\n                                markerWidth=\"7\"\n                                markerHeight=\"7\"\n                                orient=\"auto-start-reverse\"\n                            >\n                                <path\n                                    d=\"M 0 0 L 10 5 L 0 10 z\"\n                                    fill=\"#94a3b8\"\n                                />\n                            </marker>\n                            <marker\n                                id=\"network-arrow-critical\"\n                                viewBox=\"0 0 10 10\"\n                                refX=\"9\"\n                                refY=\"5\"\n                                markerWidth=\"7\"\n                                markerHeight=\"7\"\n                                orient=\"auto-start-reverse\"\n                            >\n                                <path\n                                    d=\"M 0 0 L 10 5 L 0 10 z\"\n                                    fill=\"#e11d48\"\n                                />\n                            </marker>\n                        </defs>\n                        {graph.edges.map((edge) =>\n                            edge.isCritical ? (\n                                <path\n                                    key={`halo-${edge.id}`}\n                                    d={edge.path}\n                                    fill=\"none\"\n                                    stroke=\"#fecdd3\"\n                                    strokeWidth=\"6\"\n                                />\n                            ) : null,\n                        )}\n                        {graph.edges.map((edge) => (\n                            <path\n                                key={edge.id}\n                                d={edge.path}\n                                fill=\"none\"\n                                stroke={edge.isCritical ? '#e11d48' : '#94a3b8'}\n                                strokeWidth={edge.isCritical ? 2.5 : 1.5}\n                                markerEnd={`url(#${edge.isCritical ? 'network-arrow-critical' : 'network-arrow'})`}\n                            />\n                        ))}\n                    </svg>\n\n                    {graph.nodes.map((node) => {\n                        const metrics = analysis.nodes[`${node.task.id}`];\n\n                        return (\n                            <button\n                                key={node.task.id}\n                                type=\"button\"\n                                onClick={() => onSelect(node.task)}\n                                className={cn(\n                                    'absolute flex flex-col rounded-xl border-2 bg-white p-3 text-left shadow-sm transition hover:-translate-y-0.5 hover:shadow-md',\n                                    node.isCritical\n                                        ? 'border-rose-400 bg-rose-50/70'\n                                        : 'border-slate-200',\n                                )}\n                                style={{\n                                    left: node.x,\n                                    top: node.y,\n                                    width: NODE_WIDTH,\n                                    height: NODE_HEIGHT,\n                                }}\n                            >\n                                <div className=\"flex items-start justify-between gap-2\">\n                                    <span className=\"line-clamp-2 text-xs font-semibold text-slate-800\">\n                                        {node.task.name}\n                                    </span>\n                                    {node.isCritical ? (\n                                        <span className=\"flex shrink-0 items-center gap-0.5 rounded bg-rose-500 px-1 py-0.5 text-[9px] font-semibold text-white\">\n                                            <TriangleAlert className=\"h-2.5 w-2.5\" />\n                                            Kritis\n                                        </span>\n                                    ) : null}\n                                </div>\n\n                                <div className=\"mt-1 text-[10px] text-slate-400\">\n                                    Durasi {node.task.duration_days} hari\n                                </div>\n\n                                <dl className=\"mt-1.5 grid grid-cols-2 gap-x-2 gap-y-0.5 text-[10px]\">\n                                    {[\n                                        ['ES', metrics?.early_start],\n                                        ['EF', metrics?.early_finish],\n                                        ['LS', metrics?.late_start],\n                                        ['LF', metrics?.late_finish],\n                                    ].map(([label, value]) => (\n                                        <div\n                                            key={label}\n                                            className=\"flex items-center justify-between\"\n                                        >\n                                            <dt className=\"text-slate-400\">\n                                                {label}\n                                            </dt>\n                                            <dd className=\"font-medium text-slate-600 tabular-nums\">\n                                                {value ?? '-'}\n                                            </dd>\n                                        </div>\n                                    ))}\n                                </dl>\n\n                                <div className=\"mt-auto flex items-center justify-between gap-2 border-t border-slate-100 pt-1.5 text-[10px]\">\n                                    <span className=\"truncate text-slate-400\">\n                                        {node.task.predecessor_name\n                                            ? `← ${node.task.predecessor_name}`\n                                            : 'Titik awal'}\n                                    </span>\n                                    <span\n                                        className={cn(\n                                            'shrink-0 rounded px-1 py-0.5 font-medium',\n                                            node.isCritical\n                                                ? 'bg-rose-100 text-rose-700'\n                                                : 'bg-slate-100 text-slate-500',\n                                        )}\n                                    >\n                                        Slack {metrics?.slack ?? 0}h\n                                    </span>\n                                </div>\n                            </button>\n                        );\n                    })}\n                </div>\n            </div>\n\n            {analysis.critical_path_names.length > 0 ? (\n                <div className=\"rounded-xl border border-rose-200 bg-rose-50 p-4\">\n                    <h3 className=\"flex items-center gap-2 text-sm font-semibold text-rose-800\">\n                        <TriangleAlert className=\"h-4 w-4\" />\n                        Jalur Kritis ({analysis.critical_path_names.length}{' '}\n                        aktivitas · {analysis.project_duration_days} hari)\n                    </h3>\n                    <p className=\"mt-1.5 text-xs leading-relaxed text-rose-700\">\n                        {analysis.critical_path_names.join('  →  ')}\n                    </p>\n                    {analysis.project_start && analysis.project_end ? (\n                        <p className=\"mt-1 text-[11px] text-rose-500\">\n                            Rentang proyek:{' '}\n                            {formatLongDate(parseDate(analysis.project_start))}{' '}\n                            – {formatLongDate(parseDate(analysis.project_end))}\n                        </p>\n                    ) : null}\n                </div>\n            ) : null}\n        </div>\n    );\n}\n"
