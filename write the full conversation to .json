  "content": "import { Network, Route } from 'lucide-react';\nimport { useMemo } from 'react';\nimport { computeNetworkRanks, formatLongDate, parseDate } from '@/lib/gantt';\nimport { cn } from '@/lib/utils';\nimport type { ProjectAnalysis, Task } from '@/types/gantt';\n\ninterface NetworkDiagramProps {\n    tasks: Task[];\n    analysis: ProjectAnalysis;\n    onSelect: (task: Task) => void;\n}\n\nconst NODE_WIDTH = 188;\nconst NODE_HEIGHT = 138;\nconst GAP_X = 56;\nconst GAP_Y = 20;\nconst PADDING = 24;\n\ninterface PositionedNode {\n    task: Task;\n    x: number;\n    y: number;\n    isCritical: boolean;\n}\n\nexport default function NetworkDiagram({\n    tasks,\n    analysis,\n    onSelect,\n}: NetworkDiagramProps) {\n    const graph = useMemo(() => {\n        const ranks = computeNetworkRanks(tasks);\n        const columns = new Map<number, Task[]>();\n\n        for (const task of tasks) {\n            const rank = ranks[task.id] ?? 0;\n            const bucket = columns.get(rank) ?? [];\n            bucket.push(task);\n            columns.set(rank, bucket);\n        }\n\n        const ordered = [...columns.entries()].sort(([a], [b]) => a - b);\n        const sortColumn = (columnTasks: Task[]): Task[] =>\n            [...columnTasks].sort(\n                (a, b) =>\n                    parseDate(a.start_date).getTime() -\n                        parseDate(b.start_date).getTime() || a.id - b.id,\n            );\n\n        const columnHeights = ordered.map(\n            ([, columnTasks]) =>\n                sortColumn(columnTasks).length * NODE_HEIGHT +\n                (sortColumn(columnTasks).length - 1) * GAP_Y,\n        );\n\n        const maxHeight = Math.max(...columnHeights, 0);\n        const nodeByTaskId = new Map<number, PositionedNode>();\n\n        ordered.forEach(([rank, columnTasks], columnIndex) => {\n            const sorted = sortColumn(columnTasks);\n            const offsetY =\n                PADDING + (maxHeight - columnHeights[columnIndex]) / 2;\n\n            sorted.forEach((task, rowIndex) => {\n                nodeByTaskId.set(task.id, {\n                    task,\n                    x: PADDING + rank * (NODE_WIDTH + GAP_X),\n                    y: offsetY + rowIndex * (NODE_HEIGHT + GAP_Y),\n                    isCritical:\n                        analysis.nodes[`${task.id}`]?.is_critical ?? false,\n                });\n            });\n        });\n\n        const nodes = [...nodeByTaskId.values()];\n        const edges: { id: string; path: string; isCritical: boolean }[] = [];\n\n        for (const task of tasks) {\n            if (task.predecessor_id === null) {\n                continue;\n            }\n\n            const source = nodeByTaskId.get(task.predecessor_id);\n            const target = nodeByTaskId.get(task.id);\n\n            if (!source || !target) {\n                continue;\n            }\n\n            // Start at the right edge, end just before the target's left edge\n            // so the arrow head is not hidden underneath the node.\n            const x1 = source.x + NODE_WIDTH;\n            const y1 = source.y + NODE_HEIGHT / 2;\n            const x2 = target.x - 4;\n            const y2 = target.y + NODE_HEIGHT / 2;\n\n            edges.push({\n                id: `${source.task.id}-${task.id}`,\n                path: `M ${x1} ${y1} C ${x1 + 40} ${y1}, ${x2 - 40} ${y2}, ${x2} ${y2}`,\n                isCritical: source.isCritical && target.isCritical,\n            });\n        }\n\n        const width =\n            Math.max(...nodes.map((node) => node.x + NODE_WIDTH), 0) + PADDING;\n        const height =\n            Math.max(...nodes.map((node) => node.y + NODE_HEIGHT), 0) + PADDING;\n\n        return { nodes, edges, width, height };\n    }, [tasks, analysis]);\n\n    if (tasks.length === 0) {\n        return (\n            <div className=\"flex flex-col items-center justify-center gap-2 rounded-md border border-dashed border-gray-300 bg-white px-6 py-16 text-center\">\n                <Network className=\"h-6 w-6 text-gray-300\" />\n                <p className=\"text-sm font-medium text-gray-700\">\n                    Diagram jaringan belum tersedia\n                </p>\n                <p className=\"max-w-sm text-xs text-gray-500\">\n                    Tambahkan tugas dan dependensi untuk membentuk diagram\n                    jaringan proyek.\n                </p>\n            </div>\n        );\n    }\n\n    return (\n        <div className=\"space-y-3\">\n            <div className=\"flex flex-wrap items-center gap-x-4 gap-y-1.5 rounded-md border border-gray-200 bg-white px-3 py-2 text-[11px] text-gray-500\">\n                <span className=\"flex items-center gap-1.5 font-medium text-gray-600\">\n                    <Route className=\"h-3.5 w-3.5\" />\n                    Activity-on-Node\n                </span>\n                <span className=\"hidden h-3 w-px bg-gray-200 sm:block\" />\n                <span>\n                    <span className=\"font-medium text-gray-600\">ES</span> Early\n                    Start\n                </span>\n                <span>\n                    <span className=\"font-medium text-gray-600\">EF</span> Early\n                    Finish\n                </span>\n                <span>\n                    <span className=\"font-medium text-gray-600\">LS</span> Late\n                    Start\n                </span>\n                <span>\n                    <span className=\"font-medium text-gray-600\">LF</span> Late\n                    Finish\n                </span>\n                <span className=\"flex items-center gap-1.5\">\n                    <span className=\"h-2 w-2 rounded-sm bg-red-600\" />\n                    Kritis (slack 0)\n                </span>\n                <span className=\"ml-auto hidden text-gray-400 md:block\">\n                    Geser horizontal untuk melihat seluruh jaringan\n                </span>\n            </div>\n\n            <div className=\"overflow-x-auto rounded-md border border-gray-200 bg-white\">\n                <div\n                    className=\"relative\"\n                    style={{ width: graph.width, height: graph.height }}\n                >\n                    <svg\n                        className=\"pointer-events-none absolute top-0 left-0\"\n                        width={graph.width}\n                        height={graph.height}\n                        aria-hidden=\"true\"\n                    >\n                        <defs>\n                            <marker\n                                id=\"network-arrow\"\n                                viewBox=\"0 0 10 10\"\n                                refX=\"9\"\n                                refY=\"5\"\n                                markerWidth=\"6\"\n                                markerHeight=\"6\"\n                                orient=\"auto-start-reverse\"\n                            >\n                                <path\n                                    d=\"M 0 0 L 10 5 L 0 10 z\"\n                                    fill=\"#9ca3af\"\n                                />\n                            </marker>\n                            <marker\n                                id=\"network-arrow-critical\"\n                                viewBox=\"0 0 10 10\"\n                                refX=\"9\"\n                                refY=\"5\"\n                                markerWidth=\"6\"\n                                markerHeight=\"6\"\n                                orient=\"auto-start-reverse\"\n                            >\n                                <path\n                                    d=\"M 0 0 L 10 5 L 0 10 z\"\n                                    fill=\"#dc2626\"\n                                />\n                            </marker>\n                        </defs>\n                        {graph.edges.map((edge) => (\n                            <path\n        