  "content": "<?php\n\nnamespace App\\Support;\n\nuse App\\Enums\\DependencyType;\nuse App\\Enums\\TaskType;\nuse App\\Models\\Task;\nuse Carbon\\CarbonInterface;\nuse Illuminate\\Support\\Collection;\n\n/**\n * Critical Path Method analysis for the project schedule.\n *\n * Only \"regular\" and \"milestone\" activities take part in the dependency\n * network — summary tasks are rollups of their children and are excluded.\n *\n * All CPM values (early/late start and finish, slack, project duration) are\n * expressed in WORKING days measured from the project start, matching how\n * Microsoft Project and Primavera P6 report schedule metrics. The stored\n * `start_date` / `end_date` remain real calendar dates.\n *\n * Relation semantics with lag L:\n *  - FS: successor starts after the predecessor finishes   -> ES_s >= EF_p + L\n *  - SS: successor starts after the predecessor starts     -> ES_s >= ES_p + L\n *  - FF: successor finishes after the predecessor finishes -> ES_s >= EF_p + L - dur_s\n *  - SF: successor finishes after the predecessor starts   -> ES_s >= ES_p + L - dur_s\n *\n * A negative lag acts as a lead (the successor may overlap the predecessor).\n */\nclass CriticalPathAnalyzer\n{\n    /**\n     * Analyse the given activities and return the schedule network.\n     *\n     * @param  Collection<int, Task>  $tasks\n     * @return array{\n     *     has_tasks: bool,\n     *     project_start: string|null,\n     *     project_end: string|null,\n     *     project_duration_days: int,\n     *     critical_path_ids: array<int, int>,\n     *     critical_path_names: array<int, string>,\n     *     nodes: array<int, array{\n     *         id: int,\n     *         wbs_code: string,\n     *         name: string,\n     *         task_type: string,\n     *         is_milestone: bool,\n     *         duration_days: int,\n     *         early_start: int,\n     *         early_finish: int,\n     *         late_start: int,\n     *         late_finish: int,\n     *         slack: int,\n     *         is_critical: bool\n     *     }>\n     * }\n     */\n    public function analyze(Collection $tasks): array\n    {\n        $activities = $tasks->filter(\n            fn (Task $task): bool => $task->task_type !== TaskType::Summary,\n        )->values();\n\n        if ($activities->isEmpty()) {\n            return $this->emptyResult();\n        }\n\n        /** @var array<int, Task> $byId */\n        $byId = $activities->keyBy('id')->all();\n\n        $projectStart = $activities\n            ->map(fn (Task $task): CarbonInterface => $task->start_date->copy()->startOfDay())\n            ->sort()\n            ->first();\n\n        $duration = [];\n        $earlyStart = [];\n        $earlyFinish = [];\n        $lateStart = [];\n        $lateFinish = [];\n        $slack = [];\n\n        foreach ($byId as $id => $task) {\n            $duration[$id] = max(0, (int) $task->duration_days);\n            $earlyStart[$id] = WorkingCalendar::workingDaysBetween(\n                $projectStart,\n                $task->start_date,\n            );\n            $earlyFinish[$id] = $earlyStart[$id] + $duration[$id];\n            $lateStart[$id] = 0;\n            $lateFinish[$id] = 0;\n            $slack[$id] = 0;\n        }\n\n        $order = $this->topologicalOrder($byId);\n\n        // Forward pass: earliest start/finish of every activity.\n        foreach ($order as $id) {\n            $predecessorId = $this->dependencyId($byId[$id], $byId);\n\n            if ($predecessorId !== null) {\n                $earlyStart[$id] = max(\n                    $earlyStart[$id],\n                    $this->forwardConstraint(\n                        $byId[$id],\n                        $predecessorId,\n                        $earlyStart,\n                        $earlyFinish,\n                        $duration,\n                    ),\n                );\n            }\n\n            $earlyFinish[$id] = $earlyStart[$id] + $duration[$id];\n        }\n\n        $projectEnd = $earlyFinish === [] ? 0 : max($earlyFinish);\n        $successors = $this->successorMap($byId);\n\n        // Backward pass: latest start/finish without delaying the project.\n        foreach (array_reverse($order) as $id) {\n            $dependents = $successors[$id] ?? [];\n\n            if ($dependents === []) {\n                $lateFinish[$id] = $projectEnd;\n            } else {\n                $lateFinish[$id] = min(array_map(\n                    fn (int $successorId): int => $this->backwardConstraint(\n                        $byId[$successorId],\n                        $id,\n                        $lateStart,\n                        $lateFinish,\n                        $duration,\n                    ),\n                    $dependents,\n                ));\n            }\n\n            $lateStart[$id] = $lateFinish[$id] - $duration[$id];\n            $slack[$id] = $lateStart[$id] - $earlyStart[$id];\n        }\n\n        $nodes = [];\n\n        foreach ($byId as $id => $task) {\n            $nodes[$id] = [\n                'id' => $id,\n                'wbs_code' => $task->wbs_code,\n                'name' => $task->name,\n                'task_type' => $task->task_type->value,\n                'is_milestone' => $task->isMilestone(),\n                'duration_days' => $duration[$id],\n                'early_start' => $earlyStart[$id],\n                'early_finish' => $earlyFinish[$id],\n                'late_start' => $lateStart[$id],\n                'late_finish' => $lateFinish[$id],\n                'slack' => $slack[$id],\n                'is_critical' => $slack[$id] <= 0,\n            ];\n        }\n\n        $critical = collect($byId)\n            ->filter(fn (Task $task): bool => $slack[$task->id] <= 0)\n            ->sortBy(fn (Task $task): int => $earlyStart[$task->id]);\n\n        return [\n            'has_tasks' => true,\n            'project_start' => $projectStart->toDateString(),\n            'project_end' => WorkingCalendar::finishDate($projectStart, $projectEnd)->toDateString(),\n            'project_duration_days' => $projectEnd,\n            'critical_path_ids' => $critical->map(fn (Task $task): int => $task->id)->values()->all(),\n            'critical_path_names' => $critical->map(fn (Task $task): string => $task->name)->values()->all(),\n            'nodes' => $nodes,\n        ];\n    }\n\n    /**\n     * Order activities so every task appears after its predecessor.\n     *\n     * @param  array<int, Task>  $tasks\n     * @return array<int, int>\n     */\n    private function topologicalOrder(array $tasks): array\n    {\n        $indegree = [];\n        $successors = [];\n\n        foreach ($tasks as $id => $task) {\n            $indegree[$id] = 0;\n            $predecessorId = $this->dependencyId($task, $tasks);\n\n            if ($predecessorId === null) {\n                continue;\n            }\n\n            $indegree[$id]++;\n            $successors[$predecessorId][] = $id;\n        }\n\n        $queue = array_keys(array_filter($indegree, fn (int $degree): bool => $degree === 0));\n        sort($queue);\n\n        $order = [];\n\n        for ($cursor = 0; $cursor < count($queue); $cursor++) {\n            $id = $queue[$cursor];\n            $order[] = $id;\n\n            foreach ($successors[$id] ?? [] as $successorId) {\n                $indegree[$successorId]--;\n\n                if ($indegree[$successorId] === 0) {\n                    $queue[] = $successorId;\n                }\n            }\n        }\n\n        // Guard against cycles: append whatever could not be ordered so the\n        // analysis still renders instead of failing.\n        if (count($order) < count($tasks)) {\n            foreach (array_keys($tasks) as $id) {\n                if (! in_array($id, $order, true)) {\n                    $order[] = $id;\n                }\n            }\n        }\n\n        return $order;\n    }\n\n    /**\n     * Resolve a task's predecessor, ignoring self references.\n     *\n     * @param  array<int, Task>  $tasks\n     */\n    private function dependencyId(Task $task, array $tasks): ?int\n    {\n        $predecessorId = $task->predecessor_id;\n\n        if ($predecessorId === null || $predecessorId === $task->id) {\n            return null;\n        }\n\n        return isset($tasks[$predecessorId]) ? $predecessorId : null;\n    }\n\n    /**\n     * Earliest working-day offset the successor may start at.\n     *\n     * @param  array<int, int>  $earlyStart\n     * @param  array<int, int>  $earlyFinish\n     * @param  array<int, int>  $duration\n     */\n    private function forwardConstraint(\n        Task $successor,\n        int $predecessorId,\n        array $earlyStart,\n        array $earlyFinish,\n        array $duration,\n    ): int {\n        $lag = (int) $successor->lag_days;\n\n        return match ($successor->dependency_type) {\n            DependencyType::StartToStart => $earlyStart[$predecessorId] + $lag,\n            DependencyType::FinishToFinish => $earlyFinish[$predecessorId] + $lag - $duration[$successor->id],\n            DependencyType::StartToFinish => $earlyStart[$predecessorId] + $lag - $duration[$successor->id],\n            default => $earlyFinish[$predecessorId] + $lag,\n        };\n    }\n\n    /**\n     * Latest working-day offset the predecessor may finish at.\n     *\n     * @param  array<int, int>  $lateStart\n     * @param  array<int, int>  $lateFinish\n     * @param  array<int, int>  $duration\n     */\n    private function backwardConstraint(\n        Task $successor,\n        int $predecessorId,\n        array $lateStart,\n        array $lateFinish,\n        array $duration,\n    ): int {\n        $lag = (int) $successor->lag_days;\n\n        return match ($successor->dependency_type) {\n            DependencyType::StartToStart => $lateStart[$successor->id] - $lag + $duration[$predecessorId],\n            DependencyType::FinishToFinish => $lateFinish[$successor->id] - $lag,\n            DependencyType::StartToFinish => $lateFinish[$successor->id] - $lag + $duration[$predecessorId],\n            default => $lateStart[$successor->id] - $lag,\n        };\n    }\n\n    /**\n     * Map every task id to the ids of the tasks that depend on it.\n     *\n     * @param  array<int, Task>  $tasks\n     * @return array<int, array<int, int>>\n     */\n    private function successorMap(array $tasks): array\n    {\n        $successors = [];\n\n        foreach ($tasks as $task) {\n            $predecessorId = $this->dependencyId($task, $tasks);\n\n            if ($predecessorId !== null) {\n                $successors[$predecessorId][] = $task->id;\n            }\n        }\n\n        return $successors;\n    }\n\n    /**\n     * @return array{\n     *     has_tasks: bool,\n     *     project_start: null,\n     *     project_end: null,\n     *     project_duration_days: int,\n     *     critical_path_ids: array<int, int>,\n     *     critical_path_names: array<int, string>,\n     *     nodes: array<int, array<string, mixed>>\n     * }\n     */\n    private function emptyResult(): array\n    {\n        return [\n            'has_tasks' => false,\n            'project_start' => null,\n            'project_end' => null,\n            'project_duration_days' => 0,\n            'critical_path_ids' => [],\n            'critical_path_names' => [],\n            'nodes' => [],\n        ];\n    }\n}\n"
