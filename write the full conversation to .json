      "newString": "    /**\n     * Forward-schedule a set of activities purely from their dependencies.\n     *\n     * Returns the earliest start of every activity as a working-day offset\n     * from the project start, which callers can turn into real dates with\n     * {@see WorkingCalendar::addWorkingDays()}. Used by the seeder to lay out\n     * a realistic project without hand-computing dates.\n     *\n     * @param  Collection<int, Task>  $tasks\n     * @return array<int, int>\n     */\n    public function resolveStartOffsets(Collection $tasks): array\n    {\n        $activities = $tasks->filter(\n            fn (Task $task): bool => $task->task_type !== TaskType::Summary,\n        )->values();\n\n        if ($activities->isEmpty()) {\n            return [];\n        }\n\n        /** @var array<int, Task> $byId */\n        $byId = $activities->keyBy('id')->all();\n\n        $duration = [];\n        $earlyStart = [];\n        $earlyFinish = [];\n\n        foreach ($byId as $id => $task) {\n            $duration[$id] = max(0, (int) $task->duration_days);\n            $earlyStart[$id] = 0;\n            $earlyFinish[$id] = $duration[$id];\n        }\n\n        foreach ($this->topologicalOrder($byId) as $id) {\n            $predecessorId = $this->dependencyId($byId[$id], $byId);\n\n            if ($predecessorId !== null) {\n                $earlyStart[$id] = max(\n                    $earlyStart[$id],\n                    $this->forwardConstraint(\n                        $byId[$id],\n                        $predecessorId,\n                        $earlyStart,\n                        $earlyFinish,\n                        $duration,\n                    ),\n                );\n            }\n\n            $earlyFinish[$id] = $earlyStart[$id] + $duration[$id];\n        }\n\n        return $earlyStart;\n    }\n\n    /**\n     * Order activities so every task appears after its predecessor.\n     *\n     * @param  array<int, Task>  $tasks\n     * @return array<int, int>\n     */\n    private function topologicalOrder(array $tasks): array",
      "allowMultiple": false
    }
  ]
}
