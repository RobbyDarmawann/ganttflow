  task,\n    tasks,\n    options,\n    onClose,\n}: TaskFormModalProps) {\n    const form = useForm<TaskFormData>(task ? formFromTask(task) : emptyForm());\n\n    const selectableTasks = orderTasksForDisplay(\n        tasks.filter((candidate) => candidate.id !== task?.id),\n    );\n\n    const dependencyEnabled = form.data.predecessor_id !== null;\n\n    const submit = (event: FormEvent): void => {\n        event.preventDefault();\n\n        const handlers = { onSuccess: () => onClose() };\n\n        if (task) {\n            form.put(update(task.id).url, handlers);\n        } else {\n            form.post(store().url, handlers);\n        }\n    };\n\n    return (\n        <Modal\n            onClose={onClose}\n            open\n            title={task ? 'Ubah Tugas' : 'Tambah Tugas'}\n            description={\n                task\n                    ? 'Perbarui detail tugas dan dependensinya.'\n                    : 'Buat aktivitas baru beserta durasi dan dependensinya.'\n            }\n            icon={<Layers className=\"h-4 w-4\" />}\n            footer={\n                <>\n                    <button\n                        type=\"button\"\n                        onClick={onClose}\n                        className=\"rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50\"\n                    >\n                        Batal\n                    </button>\n                    <button\n                        type=\"submit\"\n                        form=\"task-form\"\n                        disabled={form.processing}\n                        className=\"rounded-md bg-blue-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-blue-700 disabled:cursor-not-allowed disabled:opacity-60\"\n                    >\n                        {form.processing ? 'Menyimpan...' : 'Simpan Tugas'}\n                    </button>\n                </>\n            }\n        >\n            <form id=\"task-form\" onSubmit={submit}>\n                <div className=\"grid gap-4 sm:grid-cols-2\">\n                    <div className=\"sm:col-span-2\">\n                        <label htmlFor=\"name\" className={LABEL}>\n                            Nama Tugas\n                        </label>\n                        <input\n                            id=\"name\"\n                            type=\"text\"\n                            value={form.data.name}\n                            onChange={(event) =>\n                                form.setData('name', event.target.value)\n                            }\n                            placeholder=\"Contoh: Penyusunan Jadwal Proyek\"\n                            className={FIELD}\n                            autoFocus\n                        />\n                        {form.errors.name ? (\n                            <p className={ERROR}>{form.errors.name}</p>\n                        ) : null}\n                    </div>\n\n                    <div>\n                        <label htmlFor=\"start_date\" className={LABEL}>\n                            Tanggal Mulai\n                        </label>\n                        <input\n                            id=\"start_date\"\n                            type=\"date\"\n                            value={form.data.start_date}\n                            onChange={(event) =>\n                                form.setData('start_date', event.target.value)\n                            }\n                            className={FIELD}\n                        />\n                        {form.errors.start_date ? (\n                            <p className={ERROR}>{form.errors.start_date}</p>\n                        ) : null}\n                    </div>\n\n                    <div>\n                        <label htmlFor=\"duration_days\" className={LABEL}>\n                            Durasi (hari kerja)\n                        </label>\n                        <input\n                 