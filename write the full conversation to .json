  "content": "import { Head, router } from '@inertiajs/react';\nimport {\n    AlertTriangle,\n    BarChart3,\n    CalendarDays,\n    CheckCircle2,\n    GitBranch,\n    Info,\n    Network,\n    Pencil,\n    Plus,\n    Route,\n    Trash2,\n} from 'lucide-react';\nimport { useEffect, useState } from 'react';\nimport AboutModal from '@/components/AboutModal';\nimport GanttChart from '@/components/GanttChart';\nimport Modal from '@/components/Modal';\nimport NetworkDiagram from '@/components/NetworkDiagram';\nimport TaskFormModal from '@/components/TaskFormModal';\nimport {\n    formatLongDate,\n    orderTasksForDisplay,\n    parseDate,\n    PRIORITY_STYLES,\n    STATUS_STYLES,\n    ZOOM_CONFIG,\n} from '@/lib/gantt';\nimport { cn } from '@/lib/utils';\nimport { destroy } from '@/routes/tasks';\nimport type { GanttFlowPageProps, Task, ViewMode, ZoomLevel } from '@/types/gantt';\n\nconst ZOOM_LEVELS: ZoomLevel[] = ['day', 'week', 'month'];\n\nconst PANEL = 'rounded-md border border-gray-200 bg-white';\nconst BTN_PRIMARY =\n    'inline-flex items-center gap-1.5 rounded-md bg-blue-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-blue-700';\nconst BTN_SECONDARY =\n    'inline-flex items-center gap-1.5 rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50';\n\nfunction Segment({\n    active,\n    onClick,\n    children,\n}: {\n    active: boolean;\n    onClick: () => void;\n    children: React.ReactNode;\n}) {\n    return (\n        <button\n            type=\"button\"\n            onClick={onClick}\n            className={cn(\n                'inline-flex items-center gap-1.5 rounded px-2.5 py-1 text-xs font-medium',\n                active\n                    ? 'bg-blue-600 text-white'\n                    : 'text-gray-600 hover:bg-gray-100',\n            )}\n        >\n            {children}\n        </button>\n    );\n}\n\nfunction Metric({\n    label,\n    value,\n    hint,\n}: {\n    label: string;\n    value: string | number;\n    hint?: string;\n}) {\n    return (\n        <div\n            className=\"rounded-md border border-gray-200 bg-white px-3 py-2.5\"\n            data-stat-cell\n        >\n            <div className=\"truncate text-xs text-gray-500\">{label}</div>\n            <div className=\"mt-0.5 text-lg leading-tight font-semibold text-gray-900 tabular-nums\">\n                {value}\n            </div>\n            {hint ? (\n                <div className=\"truncate text-[11px] text-gray-400\">{hint}</div>\n            ) : null}\n        </div>\n    );\n}\n\nexport default function Index({\n    tasks,\n    analysis,\n    options,\n    flash,\n}: GanttFlowPageProps) {\n    const [view, setView] = useState<ViewMode>('gantt');\n    const [zoom, setZoom] = useState<ZoomLevel>('day');\n    const [showCriticalPath, setShowCriticalPath] = useState(true);\n    const [formOpen, setFormOpen] = useState(false);\n    const [formTask, setFormTask] = useState<Task | null>(null);\n    const [aboutOpen, setAboutOpen] = useState(false);\n    const [deleteTarget, setDeleteTarget] = useState<Task | null>(null);\n    const [toast, setToast] = useState<string | null>(flash?.success ?? null);\n\n    useEffect(() => {\n        if (!flash?.success) {\n            return;\n        }\n\n        setToast(flash.success);\n        const timer = setTimeout(() => setToast(null), 3600);\n\n        return () => clearTimeout(timer);\n    }, [flash?.success]);\n\n    const rows = orderTasksForDisplay(tasks);\n\n    const doneCount = tasks.filter((task) => task.status === 'Done').length;\n    const inProgressCount = tasks.filter(\n        (task) => task.status === 'In Progress',\n    ).length;\n\n    const openCreate = (): void => {\n        setFormTask(null);\n        setFormOpen(true);\n    };\n\n    const openEdit = (task: Task): void => {\n        setFormTask(task);\n        setFormOpen(true);\n    };\n\n    const closeForm = (): void => {\n        setFormOpen(false);\n        setFormTask(null);\n    };\n\n    const confirmDelete = (): void => {\n        if (!deleteTarget) {\n            return;\n        }\n\n        router.delete(destroy(deleteTarget.id).url, {\n            onSuccess: () => setDeleteTarget(null),\n        });\n    };\n\n    return (\n        <>\n            <Head title=\"Manajemen Proyek\" />\n\n            <div className=\"min-h-screen bg-gray-50\">\n                <header className=\"border-b border-gray-200 bg-white\">\n                    <div className=\"mx-auto flex max-w-[1500px] items-center gap-3 px-4 py-2.5\">\n                        <span className=\"flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-blue-600 text-white\">\n                            <Route className=\"h-4 w-4\" />\n                        </span>\n                        <div className=\"min-w-0 flex-1\">\n                            <h1 className=\"text-sm leading-tight font-semibold text-gray-900\">\n                                GanttFlow\n                            </h1>\n                            <p className=\"truncate text-xs leading-tight text-gray-500\">\n                                Proyek Pengadaan Sistem Informasi Kelola\n                                Pemberkasan\n                            </p>\n                        </div>\n\n                        <button\n                            type=\"button\"\n                            onClick={() => setAboutOpen(true)}\n                            className={BTN_SECONDARY}\n                        >\n                            <Info className=\"h-4 w-4\" />\n                            <span className=\"hidden sm:inline\">\n                                Tentang Aplikasi\n                            </span>\n                        </button>\n\n                        <button\n                            type=\"button\"\n                            onClick={openCreate}\n                            className={BTN_PRIMARY}\n                        >\n            