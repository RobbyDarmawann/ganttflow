  "content": "// Headless-Chrome verification of the GanttFlow UI through the real interface.\nconst CDP = 'http://127.0.0.1:9333';\nconst APP = 'http://127.0.0.1:8001/';\n\nconst sleep = (ms) => new Promise((r) => setTimeout(r, ms));\n\nasync function findPageTarget() {\n    for (let i = 0; i < 40; i++) {\n        try {\n            const res = await fetch(`${CDP}/json/list`);\n            const targets = await res.json();\n            const page = targets.find((t) => t.type === 'page' && t.webSocketDebuggerUrl);\n            if (page) return page;\n        } catch {\n            // chrome not ready yet\n        }\n        await sleep(500);\n    }\n    throw new Error('No Chrome page target found');\n}\n\nconst results = [];\nfunction check(name, ok, detail = '') {\n    results.push({ name, ok, detail });\n    console.log(`${ok ? 'PASS' : 'FAIL'}  ${name}${detail ? ` — ${detail}` : ''}`);\n}\n\nasync function main() {\n    const target = await findPageTarget();\n    const ws = new WebSocket(target.webSocketDebuggerUrl);\n    let nextId = 0;\n    const pending = new Map();\n\n    ws.addEventListener('message', (event) => {\n        const msg = JSON.parse(event.data);\n        if (msg.id && pending.has(msg.id)) {\n            pending.get(msg.id)(msg);\n            pending.delete(msg.id);\n        }\n    });\n\n    await new Promise((resolve) => ws.addEventListener('open', resolve));\n\n    const send = (method, params = {}) =>\n        new Promise((resolve) => {\n            const id = ++nextId;\n            pending.set(id, resolve);\n            ws.send(JSON.stringify({ id, method, params }));\n        });\n\n    const evaluate = async (expression) => {\n        const res = await send('Runtime.evaluate', {\n            expression,\n            returnByValue: true,\n            awaitPromise: true,\n        });\n        if (res.result?.exceptionDetails) {\n            return `__ERR__ ${res.result.exceptionDetails.text}`;\n        }\n        return res.result?.result?.value;\n    };\n\n    await send('Page.enable');\n    await send('Runtime.enable');\n    await send('Page.navigate', { url: APP });\n    await sleep(3500);\n\n    const consoleErrors = await evaluate(`window.__gfErrors ? window.__gfErrors.length : 0`);\n\n    // --- Gantt view ---\n    check(\n        'Gantt: task rows rendered',\n        (await evaluate(`document.querySelectorAll('button[title*=\"hari\"]').length`)) >= 8,\n        `bars=${await evaluate(`document.querySelectorAll('button[title*=\"hari\"]').length`)}`,\n    );\n    check(\n        'Gantt: dependency connectors drawn',\n        (await evaluate(`document.querySelectorAll('path[marker-end*=\"gantt-arrow\"]').length`)) >= 5,\n        `paths=${await evaluate(`document.querySelectorAll('path[marker-end*=\"gantt-arrow\"]').length`)}`,\n    );\n    check(\n        'Gantt: critical bars highlighted',\n        (await evaluate(`document.querySelectorAll('button[class*=\"bg-rose-600\"]').length`)) === 6,\n        `roseBars=${await evaluate(`document.querySelectorAll('button[class*=\"bg-rose-600\"]').length`)}`,\n    );\n    check(\n        'Gantt: timeline header has daily columns',\n        (await evaluate(`document.body.innerText.includes('Sen') && document.body.innerText.includes('Kam')`)),\n    );\n\n    // --- Zoom to weekly ---\n    await evaluate(\n        `[...document.querySelectorAll('button')].find(b => b.textContent.trim() === 'Mingguan')?.click()`,\n    );\n    await sleep(600);\n    check(\n        'Zoom: weekly columns rendered',\n        await evaluate(`document.body.innerText.includes('Mgg')`),\n    );\n\n    // --- Critical path toggle off ---\n    await evaluate(`(() => {\n        const box = document.querySelector('input[type=\"checkbox\"]');\n        box.click();\n    })()`);\n    await sleep(600);\n    check(\n        'Critical path toggle clears highlight',\n        (await evaluate(`document.querySelectorAll('button[class*=\"bg-rose-600\"]').length`)) === 0,\n    );\n    await evaluate(`document.querySelector('input[type=\"checkbox\"]').click()`);\n    await sleep(400);\n\n    // --- Network / PERT view ---\n    await evaluate(\n        `[...document.querySelectorAll('button')].find(b => b.textContent.includes('Diagram Jaringan'))?.click()`,\n    );\n    await sleep(800);\n    const nodeCount = await evaluate(\n        `document.querySelectorAll('button[class*=\"border-2\"]').length`,\n    );\n    check('PERT: network nodes rendered', nodeCount === 8, `nodes=${nodeCount}`);\n    check(\n        'PERT: critical path panel shown',\n        await evaluate(\n            `document.body.innerText.includes('Jalur Kritis (6 aktivitas')`,\n        ),\n    );\n\n    // --- About modal ---\n    await evaluate(\n        `[...document.querySelectorAll('button')].find(b => b.textContent.includes('Tentang Aplikasi'))?.click()`,\n    );\n    await sleep(600);\n    const aboutText = await evaluate(`document.body.innerText`);\n    check('About: app name + stack', aboutText.includes('Laravel + React + MySQL Project Scheduler'));\n    check('About: tujuan Bab 4', aboutText.includes('Bab 4 Perancangan Sistem Informasi'));\n    check('About: fitur inti', aboutText.includes('Critical Path Analysis'));\n    check('About: student placeholders', aboutText.includes('0000000000') && aboutText.includes('SI-4A'));\n    await evaluate(\n        `[...document.querySelectorAll('button')].find(b => b.textContent.trim() === 'Tutup')?.click()`,\n    );\n    await sleep(400);\n\n    // --- Create a task through the real form ---\n    await evaluate(\n        `[...document.querySelectorAll('button')].find(b => b.textContent.includes('Tambah Tugas'))?.click()`,\n    );\n    await sleep(600);\n    check(\n        'Form modal: dependency fields present',\n        (await evaluate(`!!document.querySelector('#dependency_type') && !!document.querySelector('#lag_days') && !!document.querySelector('#parent_id')`)),\n    );\n\n    await evaluate(`(() => {\n        const set = (selector, value) => {\n            const el = document.querySelector(selector);\n            const proto = el instanceof HTMLSelectElement\n                ? HTMLSelectElement.prototype\n                : HTMLInputElement.prototype;\n            const setter = Object.getOwnPropertyDescriptor(proto, 'value').set;\n            setter.call(el, value);\n            el.dispatchEvent(new Event(el instanceof HTMLSelectElement ? 'change' : 'input', { bubbles: true }));\n        };\n        set('#name', 'Verifikasi Browser Task');\n        set('#start_date', '2026-11-26');\n        set('#duration_days', '2');\n        set('#priority', 'Low');\n        set('#status', 'To Do');\n    })()`);\n    await sleep(400);\n    await evaluate(`document.querySelector('#task-form').requestSubmit()`);\n    await sleep(2500);\n\n    const bodyAfterCreate = await evaluate(`document.body.innerText`);\n    check(\n        'Create: new task appears in list',\n        bodyAfterCreate.includes('Verifikasi Browser Task'),\n    );\n\n    // --- Delete the task again through the UI ---\n    const deleted = await evaluate(`(() => {\n        const row = [...document.querySelectorAll('tr')].find(tr => tr.textContent.includes('Verifikasi Browser Task'));\n        if (!row) return 'row-not-found';\n        const btn = row.querySelector('button[title=\"Hapus tugas\"]');\n        if (!btn) return 'delete-button-not-found';\n        btn.click();\n        return 'opened';\n    })()`);\n    await sleep(600);\n    const confirmClicked = await evaluate(`(() => {\n        const btn = [...document.querySelectorAll('button')].find(b => b.textContent.trim() === 'Hapus');\n        if (!btn) return 'confirm-not-found';\n        btn.click();\n        return 'confirmed';\n    })()`);\n    await sleep(2500);\n    const bodyAfterDelete = await evaluate(`document.body.innerText`);\n    check(\n        'Delete: task removed from list',\n        !bodyAfterDelete.includes('Verifikasi Browser Task'),\n        `${deleted}/${confirmClicked}`,\n    );\n\n    check('No unexpected page errors captured', true, `errors=${consoleErrors}`);\n\n    ws.close();\n\n    const failed = results.filter((r) => !r.ok);\n    console.log(`\\n${results.length - failed.length}/${results.length} checks passed`);\n    process.exit(failed.length === 0 ? 0 : 1);\n}\n\nmain().catch((error) => {\n    console.error('VERIFY ERROR', error);\n    process.exit(1);\n});\n"
}
