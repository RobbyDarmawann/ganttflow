  "content": "import { useMemo } from 'react';\nimport { connectorPath } from '@/lib/gantt';\nimport { cn } from '@/lib/utils';\nimport type { AnalysisNode, ProjectAnalysis, Task } from '@/types/gantt';\n\nconst NODE_WIDTH = 168;\nconst NODE_HEIGHT = 92;\nconst H_GAP = 56;\nconst V_GAP = 22;\nconst PAD = 24;\n\ninterface NetworkDiagramProps {\n    tasks: Task[];\n    analysis: ProjectAnalysis;\n    showCritical: boolean;\n    onSelect: (task: Task) => void;\n}\n\ninterface PlacedNode {\n    node: AnalysisNode;\n    task: Task;\n    x: number;\n    y: number;\n    level: number;\n}\n\nexport default function NetworkDiagram({\n    tasks,\n    analysis,\n    showCritical,\n    onSelect,\n}: NetworkDiagramProps) {\n    const { nodes, width, height, edges } = useMemo(() => {\n        const byId = new Map(tasks.map((task) => [task.id, task]));\n        const analysisNodes = Object.values(analysis.nodes);\n\n        const levels = assignLevels(analysisNodes);\n        const grouped = new Map<number, PlacedNode[]>();\n\n        for (const node of analysisNodes) {\n            const level = levels.get(node.id) ?? 0;\n            const bucket = grouped.get(level) ?? [];\n            const task = byId.get(node.id);\n\n            if (task === undefined) {\n                continue;\n            }\n\n            bucket.push({ node, task, x: 0, y: 0, level });\n            grouped.set(level, bucket);\n        }\n\n        const placed: PlacedNode[] = [];\n        let maxRows = 1;\n\n        for (const [level, bucket] of [...grouped.entries()].sort(\n            (a, b) => a[0] - b[0],\n        )) {\n            bucket.sort(\n                (a, b) =>\n                    a.node.early_start - b.node.early_start ||\n                    a.node.id - b.node.id,\n            );\n            maxRows = Math.max(maxRows, bucket.length);\n\n            bucket.forEach((entry, index) => {\n                entry.x = PAD + level * (NODE_WIDTH + H_GAP);\n                entry.y = PAD + index * (NODE_HEIGHT + V_GAP);\n                placed.push(entry);\n            });\n        }\n\n        const positions = new Map(placed.map((entry) => [entry.node.id, entry]));\n        const links: { key: number; d: string }[] = [];\n\n        for (const entry of placed) {\n            const predecessorId = entry.task.predecessor_id;\n\n            if (predecessorId === null) {\n                continue;\n            }\n\n            const from = positions.get(predecessorId);\n\n            if (from === undefined) {\n                continue;\n            }\n\n            links.push({\n                key: entry.node.id,\n                d: connectorPath(\n                    {\n                        x: from.x + NODE_WIDTH,\n                        y: from.y + NODE_HEIGHT / 2,\n                    },\n                    { x: entry.x, y: entry.y + NODE_HEIGHT / 2 },\n                    { exit: 'right', enter: 'left' },\n                ),\n            });\n        }\n\n        const columns = Math.max(1, new Set(placed.map((p) => p.level)).size);\n\n        return {\n            nodes: placed,\n            edges: links,\n            width:\n                PAD * 2 + columns * NODE_WIDTH + (columns - 1) * H_GAP,\n            height: PAD * 2 + maxRows * NODE_HEIGHT + (maxRows - 1) * V_GAP,\n        };\n    }, [tasks, analysis]);\n\n    if (nodes.length === 0) {\n        return (\n            <div className=\"flex h-64 items-center justify-center rounded-md border border-gray-200 bg-white text-sm text-gray-500\">\n                Diagram jaringan akan muncul setelah ada aktivitas terjadwal.\n            </div>\n        );\n    }\n\n    return (\n        <div className=\"overflow-auto rounded-md border border-gray-200 bg-white\">\n            <div className=\"relative\" style={{ width, height }}>\n                <svg\n                    className=\"pointer-events-none absolute inset-0\"\n                    width={width}\n                    height={height}\n                >\n                    <defs>\n                        <marker\n                            id=\"network-arrow\"\n                            viewBox=\"0 0 10 10\"\n                            refX=\"9\"\n                            refY=\"5\"\n                            markerWidth=\"6\"\n                            markerHeight=\"6\"\n                            orient=\"auto-start-reverse\"\n                        >\n                            <path\n                                d=\"M 0 0 L 10 5 L 0 10 z\"\n                                fill=\"#94a3b8\"\n                            />\n                        </marker>\n                        <marker\n                            id=\"network-arrow-critical\"\n                            viewBox=\"0 0 10 10\"\n                            refX=\"9\"\n                            refY=\"5\"\n                            markerWidth=\"6\"\n                            markerHeight=\"6\"\n                            orient=\"auto-start-reverse\"\n                        >\n                            <path\n                                d=\"M 0 0 L 10 5 L 0 10 z\"\n                                fill=\"#dc2626\"\n                            />\n                        </marker>\n                    </defs>\n\n                    {edges.map((edge) => {\n                        const successor = nodes.find(\n                            (entry) => entry.node.id === edge.key,\n                        );\n                        const critical =\n                            showCritical &&\n                            successor?.node.is_critical === true;\n\n                        return (\n                            <path\n                                key={edge.key}\n                                d={edge.d}\n                                fill=\"none\"\n                                stroke={critical ? '#dc2626' : '#cbd5e1'}\n                                strokeWidth={critical ? 2 : 1.5}\n                                markerEnd={\n                                    critical\n                                        ? 'url(#network-arrow-critical)'\n                                        : 'url(#network-arrow)'\n                                }\n                            />\n                        );\n                    })}\n                </svg>\n\n                {nodes.map((entry) => {\n                    const node = entry.node;\n                    const critical = showCritical && node.is_critical;\n\n                    return (\n                        <button\n                            key={node.id}\n                            type=\"button\"\n                            onClick={() => onSelect(entry.task)}\n                            style={{\n                                left: entry.x,\n                                top: entry.y,\n                                width: NODE_WIDTH,\n                                height: NODE_HEIGHT,\n                            }}\n                            className={cn(\n                                'absolute rounded-md border bg-white px-2.5 py-1.5 text-left shadow-sm transition hover:shadow-md',\n                                critical\n                                    ? 'border-red-400 ring-1 ring-red-300'\n                                    : 'border-gray-300',\n                            )}\n                        >\n                            <div className=\"flex items-center justify-between text-[10px] text-gray-500\">\n                                <span className=\"font-mono\">\n                                    {node.wbs_code}\n                                </span>\n                                <span\n                                    className={cn(\n                                        'rounded px-1 py-px font-medium',\n                                        node.is_milestone\n                                            ? 'bg-amber-100 text-amber-800'\n                                            : critical\n                                              ? 'bg-red-100 text-red-700'\n                                              : 'bg-gray-100 text-gray-600',\n                                    )}\n                                >\n                                    {node.is_milestone\n                                        ? 'Milestone'\n                                        : `Slack ${node.slack}d`}\n                                </span>\n                            </div>\n\n                            <p className=\"mt-0.5 line-clamp-2 text-[11px] leading-tight font-medium text-gray-900\">\n                                {node.name}\n                            </p>\n\n                            <dl className=\"mt-1 grid grid-cols-2 gap-x-2 font-mono text-[10px] text-gray-500\">\n                                <div>\n                                    ES <span className=\"text-gray-800\">{node.early_start}</span>\n                                </div>\n                                <div>\n                                    EF{' '}\n                                    <span className=\"text-gray-800\">\n                                        {node.early_finish}\n                                    </span>\n                                </div>\n                                <div>\n                                    LS <span className=\"text-gray-800\">{node.late_start}</span>\n                                </div>\n                                <div>\n                                    LF{' '}\n                                    <span className=\"text-gray-800\">\n                                        {node.late_finish}\n                                    </span>\n                                </div>\n                            </dl>\n                        </button>\n                    );\n                })}\n            </div>\n        </div>\n    );\n}\n\n/**\n * Longest chain of dependencies that reaches each activity, so every task is\n * drawn to the right of the tasks it depends on.\n */\nfunction assignLevels(nodes: AnalysisNode[]): Map<number, number> {\n    const levels = new Map<number, number>();\n\n    for (const node of nodes) {\n        levels.set(node.id, 0);\n    }\n\n    const byId = new Map(nodes.map((node) => [node.id, node]));\n\n    const resolve = (id: number, seen: Set<number>): number => {\n        if (seen.has(id)) {\n            return 0;\n        }\n\n        const cached = levels.get(id);\n\n        if (cached !== undefined) {\n            return cached;\n        }\n\n        const node = byId.get(id);\n\n        if (node === undefined) {\n            return 0;\n        }\n\n        seen.add(id);\n\n        // Only the earliest-starting predecessor defines the column, keeping\n        // the layout close to how the schedule actually flows.\n        const predecessors = nodes.filter(\n            (candidate) =>\n                candidate.id !== id &&\n                candidate.early_finish <= node.early_start,\n        );\n\n        const level =\n            predecessors.length === 0\n                ? 0\n                : Math.min(\n                      12,\n                      Math.max(\n                          ...predecessors.map(\n                              (candidate) =>\n                                  resolve(candidate.id, seen) + 1,\n                          ),\n                      ),\n                  );\n\n        levels.set(id, level);\n\n        return level;\n    };\n\n    for (const node of nodes) {\n        resolve(node.id, new Set());\n    }\n\n    return levels;\n}\n"
}
