id=\"status\"\n                            value={form.data.status}\n                            onChange={(event) =>\n                                form.setData(\n                                    'status',\n                                    event.target.value as TaskStatus,\n                                )\n                            }\n                            className={FIELD}\n                        >\n                            {options.statuses.map((status) => (\n                                <option key={status} value={status}>\n                                    {status}\n                                </option>\n                            ))}\n                        </select>\n                    </div>\n\n                    <div>\n                        <label htmlFor=\"parent_id\" className={LABEL}>\n                            Sub-tugas dari (opsional)\n                        </label>\n                        <select\n                            id=\"parent_id\"\n                            value={form.data.parent_id ?? ''}\n                            onChange={(event) =>\n                                form.setData(\n                                    'parent_id',\n                                    event.target.value\n                                        ? Number(event.target.value)\n                                        : null,\n                                )\n                            }\n                            className={FIELD}\n                        >\n                            <option value=\"\">— Tidak ada (tugas utama) —</option>\n                            {selectableTasks.map(({ task: option, depth }) => (\n                                <option key={option.id} value={option.id}>\n                                    {'\\u00A0'.repeat(depth * 3)}\n                                    {option.name}\n                                </option>\n                            ))}\n                        </select>\n                        {form.errors.parent_id ? (\n                            <p className={ERROR}>{form.errors.parent_id}</p>\n                        ) : null}\n                    </div>\n\n                    <div>\n                        <label htmlFor=\"predecessor_id\" className={LABEL}>\n                            Predecessor\n                        </label>\n                        <select\n                            id=\"predecessor_id\"\n                            value={form.data.predecessor_id ?? ''}\n                            onChange={(event) => {\n                                const value = event.target.value\n                                    ? Number(event.target.value)\n                                    : null;\n\n                                form.setData('predecessor_id', value);\n\n                                if (value === null) {\n                                    form.setData('dependency_type', null);\n                                    form.setData('lag_days', 0);\n                                }\n                            }}\n                            className={FIELD}\n                        >\n                            <option value=\"\">— Tidak ada —</option>\n                            {selectableTasks.map(({ task: option, depth }) => (\n                                <option key={option.id} value={option.id}>\n                                    {'\\u00A0'.repeat(depth * 3)}\n                                    {option.name}\n                                </option>\n                            ))}\n                        </select>\n                        {form.errors.predecessor_id ? (\n                            <p className={ERROR}>\n                                {form.errors.predecessor_id}\n                            </p>\n                        ) : null}\n                    </div>\n\n                    <div>\n                        <label htmlFor=\"dependency_type\" className={LABEL}>\n                            Jenis Dependensi\n                        </label>\n                        <select\n                            id=\"dependency_type\"\n                            disabled={!dependencyEnabled}\n                            value={form.data.dependency_type ?? ''}\n                            onChange={(event) =>\n                                form.setData(\n                                    'dependency_type',\n                                    (event.target.value ||\n                                        null) as DependencyType | null,\n                                )\n                            }\n                            className={FIELD}\n                        >\n                            <option value=\"\">— Pilih jenis —</option>\n                            {options.dependencyTypes.map((type) => (\n                                <option key={type} value={type}>\n                                    {type}\n                                </option>\n                            ))}\n                        </select>\n                        {form.errors.dependency_type ? (\n                            <p className={ERROR}>\n                                {form.errors.dependency_type}\n                            </p>\n                        ) : null}\n                    </div>\n\n                    <div>\n                        <label htmlFor=\"lag_days\" className={LABEL}>\n                            Lag / Jeda (hari)\n                        </label>\n                        <input\n                            id=\"lag_days\"\n                            type=\"number\"\n                            min={0}\n                            max={365}\n                            disabled={!dependencyEnabled}\n                            value={form.data.lag_days}\n                            onChange={(event) =>\n                                form.setData(\n                                    'lag_days',\n                                    Number(event.target.value),\n                                )\n                            }\n                            className={FIELD}\n                        />\n                        {form.errors.lag_days ? (\n                            <p className={ERROR}>{form.errors.lag_days}</p>\n                        ) : null}\n                    </div>\n\n                    <p className=\"rounded border border-gray-200 bg-gray-50 px-3 py-2 text-xs leading-relaxed text-gray-500 sm:col-span-2\">\n                        <span className=\"font-medium text-gray-600\">\n                            Finish-to-Start\n                        </span>{' '}\n                        memulai tugas setelah predecessor selesai.{' '}\n                        <span className=\"font-medium text-gray-600\">\n                            Start-to-Start\n                        </span>{' '}\n                        memulai tugas bersamaan dengan predecessor, ditambah\n                        lag jika diisi.\n                    </p>\n                </div>\n            </form>\n        </Modal>\n    );\n}\n"
}
