-1 text-[11px] text-gray-500\">\n                        Geser balok untuk memindahkan jadwal, tarik ujung kanan\n                        untuk mengubah durasi, dan klik ganda nama tugas untuk\n                        mengganti nama. Semua perubahan langsung tersimpan ke\n                        basis data.\n                    </p>\n                </main>\n            </div>\n\n            <TaskFormModal\n                open={formOpen}\n                task={editing}\n                tasks={tasks}\n                options={options}\n                processing={processing}\n                errors={errors}\n                onClose={() => {\n                    setFormOpen(false);\n                    setEditing(null);\n                }}\n                onSubmit={(payload) =>\n                    runTask(\n                        editing === null ? 'store' : 'update',\n                        payload,\n                        editing ?? undefined,\n                    )\n                }\n            />\n\n            <AboutModal open={aboutOpen} onClose={() => setAboutOpen(false)} />\n\n            <Modal\n                open={pendingDelete !== null}\n                onClose={() => setPendingDelete(null)}\n                title=\"Hapus Tugas\"\n                description=\"Tindakan ini tidak dapat dibatalkan.\"\n                size=\"md\"\n                footer={\n                    <>\n                        <button\n                            type=\"button\"\n                            onClick={() => setPendingDelete(null)}\n                            className=\"rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50\"\n                        >\n                            Batal\n                        </button>\n                        <button\n                            type=\"button\"\n                            disabled={processing}\n                            onClick={() => {\n              