check(\n        'Gantt chart re-renders from the new database row',\n        barsAfterInsert === dbCountBefore + 1,\n        `bars=${barsAfterInsert}`,\n    );\n\n    mysql(`DELETE FROM tasks WHERE name = 'UJI-INTEGRASI-DATABASE';`);\n    await reload();\n\n    const afterDelete = await evaluate(\n        `document.body.innerText.includes('UJI-INTEGRASI-DATABASE')`,\n    );\n    const dbCountAfter = Number(mysql('SELECT COUNT(*) FROM tasks;'));\n    check(\n        'Deleting the row in MySQL removes it from the UI',\n        afterDelete === false && dbCountAfter === dbCountBefore,\n        `db=${dbCountAfter}`,\n    );\n\n    // ---------------------------------------------------------- rendering\n    const bars = await evaluate(\n        `document.querySelectorAll('[data-gantt-bar]').length`,\n    );\n    const links = await evaluate(\n        `document.querySelectorAll('[data-gantt-links] path').length`,\n    );\n    const criticalRings = await evaluate(\n        `document.querySelectorAll('[data-gantt-bar].bg-red-600').length`,\n    );\n    check('Gantt: task bars rendered', bars === 8, `bars=${bars}`);\n    check('Gantt: dependency connectors drawn', links === 6, `paths=${links}`);\n    check(\n        'Gantt: critical bars highlighted',\n        criticalRings === 6,\n        `critical=${criticalRings}`,\n    );\n\n    // ------------------------------------------------------------- layout\n    const pageOverflow = await evaluate(\n        `document.documentElement.scrollWidth - document.documentElement.clientWidth`,\n    );\n    check(\n        'No horizontal page overflow',\n        pageOverflow <= 1,\n        `overflow=${pageOverflow}px`,\n    );\n\n    const nameVsTimeline = await evaluate(\n        `(() => {\n            const names = document.querySelector('[data-gantt-names]').getBoundingClientRect();\n            const timeline = document.querySelector('[data-gantt-timeline]').getBoundingClientRect();\n            return +(names.right - timeline.left).to