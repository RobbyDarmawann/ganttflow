  "content": "import { X } from 'lucide-react';\nimport { useEffect, type ReactNode } from 'react';\nimport { cn } from '@/lib/utils';\n\ninterface ModalProps {\n    open: boolean;\n    onClose: () => void;\n    title: string;\n    description?: string;\n    icon?: ReactNode;\n    children: ReactNode;\n    footer?: ReactNode;\n    size?: 'md' | 'lg';\n}\n\nexport default function Modal({\n    open,\n    onClose,\n    title,\n    description,\n    icon,\n    children,\n    footer,\n    size = 'md',\n}: ModalProps) {\n    useEffect(() => {\n        if (!open) {\n            return;\n        }\n\n        const handleKeyDown = (event: KeyboardEvent) => {\n            if (event.key === 'Escape') {\n                onClose();\n            }\n        };\n\n        document.addEventListener('keydown', handleKeyDown);\n\n        return () => document.removeEventListener('keydown', handleKeyDown);\n    }, [open, onClose]);\n\n    if (!open) {\n        return null;\n    }\n\n    return (\n        <div\n            className=\"fixed inset-0 z-50 flex overflow-y-auto p-4\"\n            data-modal-root\n        >\n            <button\n                type=\"button\"\n                aria-label=\"Tutup\"\n                onClick={onClose}\n                className=\"fixed inset-0 cursor-default bg-gray-900/50\"\n            />\n\n            <div\n                role=\"dialog\"\n                aria-modal=\"true\"\n                aria-label={title}\n                className={cn(\n                    'relative z-10 m-auto flex w-full flex-col rounded-md bg-white shadow-lg',\n                    size === 'lg' ? 'max-w-3xl' : 'max-w-2xl',\n                )}\n                data-modal-dialog\n            >\n                <header className=\"flex items-start gap-2 border-b border-gray-200 px-4 py-3\">\n                    {icon ? (\n                        <span className=\"mt-0.5 shrink-0 text-gray-400\">\n                            {icon}\n                        </span>\n                    ) : null}\n                    <div className=\"min-w-0 flex-1\">\n                        <h2 className=\"text-sm font-semibold text-gray-900\">\n                            {title}\n                        </h2>\n                        {description ? (\n                            <p className=\"mt-0.5 text-xs text-gray-500\">\n                                {description}\n                            </p>\n                        ) : null}\n                    </div>\n                    <button\n                        type=\"button\"\n                        onClick={onClose}\n                        className=\"-mt-1 -mr-1 rounded p-1 text-gray-400 hover:bg-gray-100 hover:text-gray-600\"\n                    >\n                        <X className=\"h-4 w-4\" />\n                    </button>\n                </header>\n\n                <div className=\"px-4 py-4\">{children}</div>\n\n                {footer ? (\n                    <footer className=\"flex items-center justify-end gap-2 border-t border-gray-200 bg-gray-50 px-4 py-3\">\n                        {footer}\n                    </footer>\n                ) : null}\n            </div>\n        </div>\n    );\n}\n"
}
